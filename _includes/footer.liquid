{% capture footer_name %}{{ site.first_name }} {% if site.middle_name %}{{ site.middle_name }} {% endif %}{{ site.last_name }}{% endcapture %}
{% assign footer_name = footer_name | strip %}
{% if site.footer_fixed %}
  <footer class="fixed-bottom" role="contentinfo">
    <div class="container mt-0">
      &copy; Copyright {{ site.time | date: '%Y' }}
      {{ footer_name }}. {{ site.footer_text }}
      {% if site.impressum_path %}
        <a href="{{ site.url }}{{ site.baseurl }}{{ site.impressum_path }}">Impressum</a>.
      {% endif %}
      {% if site.last_updated %}
        Last updated: {{ 'now' | date: '%B %d, %Y' }}.
      {% endif %}
    </div>
  </footer>
{% else %}
  <footer class="sticky-bottom site-footer" role="contentinfo">
    {% if site.newsletter.enabled %}
      {% include newsletter.liquid %}
    {% endif %}

    <div class="container">
      <div class="footer-main">
        <a class="footer-name" href="{{ '/' | relative_url }}">{{ footer_name }}</a>
        {% if site.data.profile_links %}
          <nav class="footer-links" aria-label="Contact and profiles">
            {% for link in site.data.profile_links %}
              {% if link.url contains '://' or link.url contains 'mailto:' %}
                {% assign link_url = link.url %}
              {% else %}
                {% assign link_url = link.url | relative_url %}
              {% endif %}
              <a href="{{ link_url }}">{{ link.short | default: link.label }}</a>
            {% endfor %}
          </nav>
        {% endif %}
      </div>
      <p class="footer-note">
        &copy; {{ site.time | date: '%Y' }} {{ footer_name }}.
        {{ site.footer_text }}
        {% if site.impressum_path %}
          <a href="{{ site.url }}{{ site.baseurl }}{{ site.impressum_path }}">Impressum</a>.
        {% endif %}
        {% if site.last_updated %}
          Last updated: {{ 'now' | date: '%B %d, %Y' }}.
        {% endif %}
      </p>
    </div>
  </footer>
{% endif %}
